{
  "info": {
    "name": "FlightBooking",
    "description": "End-to-end collection for the FlightBooking service.\n\n**How to use:**\n1. Import this file and the companion `FlightBooking.postman_environment.json`.\n2. Select the `FlightBooking (local)` environment.\n3. Boot the service:  `docker compose up -d && SPRING_PROFILES_ACTIVE=postgres $JAVA_HOME/bin/java -jar target/flight-booking-0.0.1-SNAPSHOT.jar`\n4. Run **Search flights** first — it captures the first flightId and its first available seatId into env vars (`flightId`, `seatId`).\n5. Run **Reserve itinerary** — it mints a fresh idempotency key and captures the returned `itineraryId`. The direct-flight case is a single-leg itinerary.\n6. Optionally run **Reserve itinerary (multi-leg)** — captures a fresh itineraryId for a two-hop trip if the search returned one.\n7. Run **Confirm**, then **Get itinerary** / **Cancel** as needed.\n\nAll requests use variables so you can re-run the folder as a chain (Runner) or manually one by one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flights",
      "item": [
        {
          "name": "Search flights (BLR → BOM, tomorrow)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Seed data is loaded for LocalDate.now().plusDays(1) —",
                  "// compute that in the caller's local timezone.",
                  "const d = new Date(); d.setDate(d.getDate() + 1);",
                  "const iso = d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('searchDate', iso);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const arr = pm.response.json();",
                  "pm.test('at least one itinerary', () => pm.expect(arr.length).to.be.greaterThan(0));",
                  "// Grab the first segment of the first itinerary and stash the flightId.",
                  "const firstSeg = arr[0].segments[0];",
                  "pm.collectionVariables.set('flightId', firstSeg.flightId);",
                  "console.log('captured flightId =', firstSeg.flightId);",
                  "// If a multi-hop itinerary exists, stash its two flight ids for",
                  "// the multi-leg reserve request further down the collection.",
                  "const multi = arr.find(it => it.stops >= 1);",
                  "if (multi) {",
                  "  pm.collectionVariables.set('leg1FlightId', multi.segments[0].flightId);",
                  "  pm.collectionVariables.set('leg2FlightId', multi.segments[1].flightId);",
                  "  console.log('captured multi-leg flights =', multi.segments[0].flightId, multi.segments[1].flightId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights?source={{source}}&destination={{destination}}&date={{searchDate}}&maxStops=1&sort=CHEAPEST",
              "host": ["{{baseUrl}}"],
              "path": ["flights"],
              "query": [
                { "key": "source", "value": "{{source}}" },
                { "key": "destination", "value": "{{destination}}" },
                { "key": "date", "value": "{{searchDate}}" },
                { "key": "maxStops", "value": "1" },
                { "key": "sort", "value": "CHEAPEST", "description": "CHEAPEST | FASTEST" }
              ]
            }
          }
        },
        {
          "name": "Flight details + seat map",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const firstAvail = (body.seats || []).find(s => s.status === 'AVAILABLE');",
                  "if (firstAvail) {",
                  "  pm.collectionVariables.set('seatId', firstAvail.seatId);",
                  "  console.log('captured seatId =', firstAvail.seatId, '(' + firstAvail.seatNumber + ')');",
                  "} else {",
                  "  console.warn('no AVAILABLE seat found on flight ' + pm.collectionVariables.get('flightId'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}"]
            }
          }
        },
        {
          "name": "Leg 1 seat map (for multi-leg reserve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const firstAvail = (body.seats || []).find(s => s.status === 'AVAILABLE');",
                  "if (firstAvail) {",
                  "  pm.collectionVariables.set('leg1SeatId', firstAvail.seatId);",
                  "  console.log('captured leg1SeatId =', firstAvail.seatId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/{{leg1FlightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{leg1FlightId}}"]
            }
          }
        },
        {
          "name": "Leg 2 seat map (for multi-leg reserve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const firstAvail = (body.seats || []).find(s => s.status === 'AVAILABLE');",
                  "if (firstAvail) {",
                  "  pm.collectionVariables.set('leg2SeatId', firstAvail.seatId);",
                  "  console.log('captured leg2SeatId =', firstAvail.seatId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/{{leg2FlightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{leg2FlightId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Itinerary",
      "item": [
        {
          "name": "Reserve itinerary (single leg / direct)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh idempotency key per reserve → confirm session.",
                  "const key = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('idempotencyKey', key);",
                  "console.log('idempotencyKey =', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status RESERVED', () => pm.expect(b.status).to.eql('RESERVED'));",
                  "pm.test('one leg', () => pm.expect(b.legs.length).to.eql(1));",
                  "pm.collectionVariables.set('itineraryId', b.itineraryId);",
                  "console.log('itineraryId =', b.itineraryId,",
                  "  'totalFinalPrice =', b.totalFinalPrice,",
                  "  'expiresAt =', b.expiresAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{flightId}}, \"seatId\": {{seatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Reserve itinerary (multi-leg, two-hop)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Independent session — fresh idempotency key.",
                  "const key = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('multiIdempotencyKey', key);",
                  "console.log('multiIdempotencyKey =', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status RESERVED', () => pm.expect(b.status).to.eql('RESERVED'));",
                  "pm.test('two legs', () => pm.expect(b.legs.length).to.eql(2));",
                  "pm.test('totalFinalPrice = sum of leg prices',",
                  "  () => pm.expect(Number(b.totalFinalPrice)).to.eql(",
                  "    Number(b.legs[0].finalPrice) + Number(b.legs[1].finalPrice)));",
                  "pm.collectionVariables.set('multiItineraryId', b.itineraryId);",
                  "console.log('multiItineraryId =', b.itineraryId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{multiIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{leg1FlightId}}, \"seatId\": {{leg1SeatId}} },\n    { \"flightId\": {{leg2FlightId}}, \"seatId\": {{leg2SeatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Reserve — replay same key (idempotent, returns same itineraryId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns the SAME itineraryId as first reserve',",
                  "  () => pm.expect(String(b.itineraryId)).to.eql(String(pm.collectionVariables.get('itineraryId'))));",
                  "pm.test('message notes replay',",
                  "  () => pm.expect(b.message || '').to.include('idempotent'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{flightId}}, \"seatId\": {{seatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Confirm itinerary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status CONFIRMED', () => pm.expect(b.status).to.eql('CONFIRMED'));",
                  "pm.test('confirmedAt set', () => pm.expect(b.confirmedAt).to.not.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"stripe-card-tok_visa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "confirm"]
            }
          }
        },
        {
          "name": "Confirm — replay (idempotent, no re-charge)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('still CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"stripe-card-tok_visa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "confirm"]
            }
          }
        },
        {
          "name": "Get itinerary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}"]
            }
          }
        },
        {
          "name": "Cancel itinerary",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh key per cancel session — distinct from the reserve/confirm key.",
                  "const key = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('cancelIdempotencyKey', key);",
                  "console.log('cancelIdempotencyKey =', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{cancelIdempotencyKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "cancel"]
            }
          }
        },
        {
          "name": "Cancel — replay same key (idempotent, no re-refund)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('still CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{cancelIdempotencyKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Waitlist",
      "item": [
        {
          "name": "Join waitlist (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('userId is 2 (Bob)', () => pm.expect(b.userId).to.eql(2));",
                  "pm.test('flightId echoed', () => pm.expect(String(b.flightId)).to.eql(String(pm.collectionVariables.get('flightId'))));",
                  "pm.collectionVariables.set('waitlistId', b.waitlistId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "2", "description": "Bob (not the same as {{userId}}=Alice)" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}", "waitlist"]
            }
          }
        },
        {
          "name": "Join waitlist — replay (idempotent, same waitlistId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('same waitlistId as first join',",
                  "  () => pm.expect(String(pm.response.json().waitlistId)).to.eql(String(pm.collectionVariables.get('waitlistId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "2" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}", "waitlist"]
            }
          }
        },
        {
          "name": "Leave waitlist (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "2" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}", "waitlist"]
            }
          }
        },
        {
          "name": "Leave waitlist — replay (still 204, idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "2" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}", "waitlist"]
            }
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Search — missing 'source' (400/500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights?destination=BOM&date={{searchDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights"],
              "query": [
                { "key": "destination", "value": "BOM" },
                { "key": "date", "value": "{{searchDate}}" }
              ]
            }
          }
        },
        {
          "name": "Flight not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/999999",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "999999"]
            }
          }
        },
        {
          "name": "Reserve — empty legs array (400 bean-validation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('emptyLegsKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{emptyLegsKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Reserve — duplicate leg (409, rejected before any lock)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('dupLegsKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{dupLegsKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{flightId}}, \"seatId\": {{seatId}} },\n    { \"flightId\": {{flightId}}, \"seatId\": {{seatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Reserve — replay same key with different legs (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same key as the successful reserve, different seat.",
                  "// The idempotency-mismatch check fires before the seat",
                  "// lookup so the exact seat id doesn't matter.",
                  "const original = parseInt(pm.collectionVariables.get('seatId'), 10);",
                  "pm.variables.set('mismatchedSeatId', original + 1000);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{flightId}}, \"seatId\": {{mismatchedSeatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Reserve — seat already locked (409 SeatUnavailable)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Different idempotency key so we're not just deduping the earlier reserve.",
                  "pm.variables.set('otherKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "2" },
              { "key": "X-Idempotency-Key", "value": "{{otherKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legs\": [\n    { \"flightId\": {{flightId}}, \"seatId\": {{seatId}} }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "reserve"]
            }
          }
        },
        {
          "name": "Confirm — wrong user (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "999" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"stripe-card-tok_visa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "confirm"]
            }
          }
        },
        {
          "name": "Waitlist — active-booking owner tries to join (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}", "description": "Alice, who already has a confirmed leg on {{flightId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}", "waitlist"]
            }
          }
        },
        {
          "name": "Waitlist — unknown flight (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "2" }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/999999/waitlist",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "999999", "waitlist"]
            }
          }
        },
        {
          "name": "Cancel — wrong user (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh key so we're not accidentally hitting the idempotency-replay path.",
                  "pm.variables.set('otherCancelKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "999" },
              { "key": "X-Idempotency-Key", "value": "{{otherCancelKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{itineraryId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{itineraryId}}", "cancel"]
            }
          }
        },
        {
          "name": "Cancel — RESERVED itinerary is refused (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cancel of a still-RESERVED itinerary is refused because",
                  "// a reservation has no charge to refund and its Redis",
                  "// seat locks expire on their own after the TTL.",
                  "pm.variables.set('reservedCancelKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Idempotency-Key", "value": "{{reservedCancelKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/itinerary/{{multiItineraryId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["itinerary", "{{multiItineraryId}}", "cancel"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1", "description": "Alice=1, Bob=2, Carol=3 (from DataSeeder)" },
    { "key": "source", "value": "BLR" },
    { "key": "destination", "value": "BOM" },
    { "key": "searchDate", "value": "" },
    { "key": "flightId", "value": "" },
    { "key": "seatId", "value": "" },
    { "key": "leg1FlightId", "value": "" },
    { "key": "leg2FlightId", "value": "" },
    { "key": "leg1SeatId", "value": "" },
    { "key": "leg2SeatId", "value": "" },
    { "key": "itineraryId", "value": "" },
    { "key": "multiItineraryId", "value": "" },
    { "key": "idempotencyKey", "value": "" },
    { "key": "multiIdempotencyKey", "value": "" },
    { "key": "cancelIdempotencyKey", "value": "" },
    { "key": "waitlistId", "value": "" }
  ]
}
